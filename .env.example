# 1. Copy this file to .env.local (never commit .env.local).
# 2. Fill all three required values from LiveKit Cloud or your LiveKit server.
# 3. Run `corepack pnpm dev`, then open http://localhost:3000.

# REQUIRED FOR THE MANAGED "DEMO" FLOW
# ####################################
# Generate the API key and secret in the LiveKit Cloud dashboard or configure
# credentials for your self-hosted LiveKit server. The URL must use ws:// or wss://.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Example: wss://my-livekit-project.livekit.cloud
LIVEKIT_URL=


# OPTIONAL SETTINGS
# #################
# Recording
# S3_KEY_ID=
# S3_KEY_SECRET=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=

# PUBLIC
# Uncomment settings menu when using a LiveKit Cloud, it'll enable Krisp noise filters.
# NEXT_PUBLIC_SHOW_SETTINGS_MENU=true
# NEXT_PUBLIC_LK_RECORD_ENDPOINT=/api/record
# Optional, override the endpoint used to fetch connection details (token).
# NEXT_PUBLIC_CONN_DETAILS_ENDPOINT=/api/connection-details

# Optional, to pipe logs to datadog
# NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=client-token
# NEXT_PUBLIC_DATADOG_SITE=datadog-site

# Optional local companion for global push-to-talk and standard BitTorrent peers.
# Torrent cinema falls back to browser WebTorrent when the companion is unavailable.
# NEXT_PUBLIC_COMPANION_WS_URL=ws://127.0.0.1:7331
# Set NEXT_PUBLIC_PTT_WS_URL to an empty value to disable only global push-to-talk.
# NEXT_PUBLIC_PTT_WS_URL=ws://127.0.0.1:7331
